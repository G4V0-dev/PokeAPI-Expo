# Google AI Studio (https://aistudio.google.com/apikey) — el .env real nunca se commitea
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Modelo del cerebro (configurable). gemini-3.1-flash-lite tiene free tier.
GEMINI_MODEL=gemini-3.1-flash-lite

PORT=3104

# Overrides opcionales de los micros consultados (default: nube Render)
# POKE_API_URL=http://localhost:3101
# NARUTO_API_URL=http://localhost:3102
# TEACHERS_API_URL=http://localhost:3103
