# Proveedores soportados (el front elige uno por request; el .env real nunca se commitea)
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=tu_api_key_de_deepseek
DEEPSEEK_MODEL=deepseek-chat

# Proveedor por defecto si el front no manda uno
DEFAULT_AI_PROVIDER=gemini

PORT=3104

# Overrides opcionales de los micros consultados (default: nube Render)
# POKE_API_URL=http://localhost:3101
# NARUTO_API_URL=http://localhost:3102
# TEACHERS_API_URL=http://localhost:3103
