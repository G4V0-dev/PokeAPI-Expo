# Copia este archivo como backend-ai/.env (git lo ignora).
# El micro arranca aunque falten keys; /chat responde 503 para el proveedor sin key.

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (https://platform.deepseek.com/api_keys) - API compatible con OpenAI
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Proveedor por defecto si el front no envía uno
DEFAULT_AI_PROVIDER=gemini

PORT=3004

# Micros locales consultados por las herramientas del asistente
POKE_API_URL=http://localhost:3001
NARUTO_API_URL=http://localhost:3002

# Overrides opcionales (tests o despliegue)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
